config interface 'loopback'
        option device 'lo'
        list ipaddr '127.0.0.1/8'

config globals 'globals'
        option dhcp_default_duid '00046cf4b74c150942fdae5141e357b3d049'
        option ula_prefix 'fd06:c6c9:3da8::/48'

config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'lan2'
        list ports 'lan3'
        list ports 'lan4'

config interface 'lan'
        option device 'br-lan'
        option proto 'static'
        list ipaddr '192.168.100.1/24'
        option ip6assign '60'

config device
        option name 'wan'
        option macaddr '90:fb:5d:15:b2:ab'

config interface 'wan'
        option device 'wan'
        option proto 'dhcp'

config interface 'wan6'
        option device 'wan'
        option proto 'dhcpv6'

config interface 'wwan'
        option proto 'dhcp'
